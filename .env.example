# Application URLs
APP_URL=https://app.artecheck.com.br
API_URL=https://app.artecheck.com.br
PORT=3000

# Frontend API base URL — set to the Railway backend URL in production.
# In local dev / Bolt Preview leave empty so relative /api/* calls are used.
VITE_API_BASE_URL=

# Gemini API Key (Optional AI Assistant layer)
GEMINI_API_KEY=

# Supabase Configuration (Cloud sync & auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Billing Configuration (Mercado Pago)
BILLING_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_WEBHOOK_URL=

# CORS — comma-separated list of additional allowed frontend origins
CORS_ALLOWED_ORIGINS=
